menu "MicroTech product integration"

choice MAIN_PROJECT_TASK_AFFINITY
    prompt "Project-owned task core affinity"
    default MAIN_PROJECT_TASK_AFFINITY_NO_AFFINITY
    help
        Select one core for tasks created by project-owned components. The
        default preserves scheduler freedom; diagnostic profiles may isolate
        application and service work from the LVGL worker.

config MAIN_PROJECT_TASK_AFFINITY_CPU0
    bool "CPU0"
    depends on !FREERTOS_UNICORE

config MAIN_PROJECT_TASK_AFFINITY_CPU1
    bool "CPU1"
    depends on !FREERTOS_UNICORE

config MAIN_PROJECT_TASK_AFFINITY_NO_AFFINITY
    bool "No affinity"

endchoice

config MAIN_PROJECT_TASK_CORE_ID
    hex
    default 0x0 if MAIN_PROJECT_TASK_AFFINITY_CPU0
    default 0x1 if MAIN_PROJECT_TASK_AFFINITY_CPU1
    default FREERTOS_NO_AFFINITY

config MAIN_DISPLAY_BENCHMARK
    bool "Enable the display benchmark product profile"
    depends on APP_MANAGER_DISPLAY_DIAGNOSTICS
    default n
    help
        Build the root-owned runtime benchmark from a generated typed profile.
        Production configurations must leave this disabled.

endmenu
