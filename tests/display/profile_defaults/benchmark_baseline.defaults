CONFIG_APP_MANAGER_LVGL_PARTIAL_BUFFER_HEIGHT=60
CONFIG_APP_MANAGER_PRESENTATION_SNAPSHOT_ANIMATION=y
CONFIG_MAIN_DISPLAY_BENCHMARK=y
