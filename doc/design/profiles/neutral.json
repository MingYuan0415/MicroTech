      {
        "foreground": "ink_muted",
        "background": "canvas",
        "floor": "body"
      },
      {
        "foreground": "ink_faint",
        "background": "canvas",
        "floor": "faint"
      },
      {
        "foreground": "on_accent",
        "background": "accent",
        "floor": "body"
      }
    ],
    "min_contrast_faint": 4.0
  },
  "requires": {
    "color_modes": [
      "rgb565",
      "grayscale",
      "mono"
    ],
    "min_refresh_hz": 0
